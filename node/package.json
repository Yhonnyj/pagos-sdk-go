{
  "name": "tucapi",
  "version": "0.1.0",
  "description": "TuCapi SDK for the payments API v2.6.0: payins, payouts, events and webhook verification. Generated header: GENERADO POR scripts/generar_sdk_v2.go DESDE api/openapi-v2.json — NO EDITAR A MANO.",
  "keywords": ["tucapi", "payments", "payins", "payouts", "webhooks", "venezuela"],
  "homepage": "https://api.tucapi.app/v2/docs",
  "repository": { "type": "git", "url": "git+https://github.com/Yhonnyj/pagos-sdk-go.git" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/index.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "SEE LICENSE IN README.md",
  "publishConfig": { "access": "public" }
}
